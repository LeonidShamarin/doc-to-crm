# Обов'язково для екстракції: ключ Gemini (безкоштовного тіру достатньо).
# Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опційно: модель. Дефолт — gemini-3.5-flash-lite (щедріша денна квота).
# DOC_MODEL=gemini-3.5-flash-lite

# Опційно: порт HTTP-сервісу. Дефолт 7860 — саме його очікує Hugging Face
# Spaces від Docker-контейнера. Локально можна ставити будь-який.
# PORT=7860

# Опційно: поріг впевненості по полю. Нижче нього поле підсвічується в
# review-UI, а документ іде на ручну перевірку.
# MIN_FIELD_CONFIDENCE=0.75
